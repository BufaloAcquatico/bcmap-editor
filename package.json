{
    "name": "bcmap-editor",
    "version": "1.0.0",
    "description": "Browser-based map editor for ropeybot map system",
    "main": "map-editor.html",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc && node scripts/embed-js.js",
        "dev": "tsc --watch",
        "download-assets": "ts-node scripts/download-assets.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit test",
        "test:e2e:docker:unit": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit test-unit"
    },
    "keywords": [
        "map-editor",
        "ropeybot",
        "bondage-club"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/lz-string": "^1.3.37",
        "@types/node": "^20.10.0",
        "playwright": "^1.40.0",
        "prettier": "^3.9.9",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.0",
        "vitest": "^1.0.0"
    },
    "packageManager": "pnpm@9.15.5+sha512.845196026aab1cc3f098a0474b64dfbab2afe7a1b4e91dd86895d8e4aa32a7a6d03049e2d0ad770bbe4de023a7122fb68c1a1d6e0d033c7076085f9d5d4800d4"
}
